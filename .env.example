# Copy to .env and fill in. Never commit .env.
# Only VITE_* values are exposed to the browser bundle — never put service-role keys or other secrets here.

# Supabase project "React QMS" (xvpgrmujayytbbmhnoan): Project Settings -> API
VITE_SUPABASE_URL=https://xvpgrmujayytbbmhnoan.supabase.co
VITE_SUPABASE_KEY=<supabase anon / publishable key>

# UniRate currency exchange API (client-side; treat as public)

# Links shown on the sign-up page (optional; the names are shown without a link until set)
VITE_TERMS_URL=
VITE_PRIVACY_URL=

# Where the Help item in the profile menu goes (optional; the item is shown switched off until set)
VITE_HELP_URL=

# QMS API (api/ workspace). Organisation settings and onboarding call it; default http://localhost:3001
VITE_API_URL=http://localhost:3001
