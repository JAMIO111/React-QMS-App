{
  "name": "@qms/api",
  "version": "0.1.0",
  "private": true,
  "description": "QMS platform API (NestJS). See docs/phase-1-plan.md \u00a74.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "npm run build && npm run start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.json",
    "test:e2e": "jest --config jest.e2e.config.json --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "drizzle-orm": "0.44.7",
    "jose": "5.10.0",
    "nestjs-pino": "4.6.1",
    "pg": "8.23.1",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.18.12",
    "@types/pg": "8.15.6",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": "^22.9 || ^24"
  }
}
