# Copy to api/.env (untracked) or set as environment secrets. Never commit real values.

# Connection for the qms_api login (supabase/migrations/20251103120000_api_role.sql).
# Supabase pooler (transaction mode) user is "qms_api.<project-ref>":
#   postgresql://qms_api.xvpgrmujayytbbmhnoan:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
DATABASE_POOL_MAX=10

# Token verification. SUPABASE_URL enables JWKS (asymmetric signing keys) and sets the issuer.
# SUPABASE_JWT_SECRET is only for projects still on the legacy shared HS256 secret.
SUPABASE_URL=https://xvpgrmujayytbbmhnoan.supabase.co
SUPABASE_JWT_SECRET=

PORT=3001
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=300
LOG_LEVEL=info

# Optional (Phase 1.5): send invitation emails via Supabase Auth. Keep server-side only.
SUPABASE_SERVICE_ROLE_KEY=
INVITE_REDIRECT_URL=http://localhost:5173/set-password?mode=invite

# Optional: email notifications (docs/email-oauth-plan.md). Unset / none = outbox only: emails are built and kept, marked not sent.
# MAIL_PROVIDER=resend needs RESEND_API_KEY (server-side only) and MAIL_FROM on a domain verified with Resend.
MAIL_PROVIDER=none
RESEND_API_KEY=
MAIL_FROM=
# Links in emails point here (also used for Stripe return links).
APP_BASE_URL=http://localhost:5173
