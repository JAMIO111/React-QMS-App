<Project Sdk="Microsoft.NET.Sdk.Worker">
  <!-- FortressAgent.exe: the Windows service, and the commands to register, check and remove the agent. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>FortressAgent</AssemblyName>
    <RootNamespace>Fortress.Agent.Host</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fortress.Agent.Core\Fortress.Agent.Core.csproj" />
    <ProjectReference Include="..\Fortress.Agent.Adapters\Fortress.Agent.Adapters.csproj" />
  </ItemGroup>
</Project>
